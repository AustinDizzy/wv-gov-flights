{
  "name": "golden-dome-airways",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Public records and flight-path data for West Virginia state aircraft.",
  "license": "CC0-1.0",
  "homepage": "https://l.abs.codes/wv-gov-flights",
  "repository": {
    "type": "git",
    "url": "https://github.com/AustinDizzy/wv-gov-flights.git"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types --env-file .dev.vars.example",
    "typecheck": "astro check && tsc --noEmit",
    "test": "npm run test:unit && npm run test:workers",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:validate": "vitest run --config vitest.workers.config.ts tests/workers/platform.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy",
    "pages-redirect:deploy": "wrangler pages deploy ./infra/pages-redirect --project-name wv-gov-flights --branch main --commit-dirty=true"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.3",
    "@astrojs/react": "^6.0.1",
    "@fontsource/comic-neue": "^5.3.0",
    "@mistralai/mistralai": "^2.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.1",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.25.0",
    "radix-ui": "^1.6.5",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.0",
    "simplify-js": "^1.2.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@playwright/test": "^1.61.1",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/runner": "^4.1.10",
    "@vitest/snapshot": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "leaflet.heat": "^0.2.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
