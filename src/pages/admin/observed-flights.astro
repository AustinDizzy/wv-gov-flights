---
import { env } from "cloudflare:workers";
import { createDatabase } from "../../db/client";
import { getObservedFlightReviewPageData } from "../../lib/db/admin-queries";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BackfillForm, CandidateAction } from "../../components/AdminOperations";
import { appPath } from "../../lib/config";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "../../components/ui/table";
const { aircraft, candidates } =
  await getObservedFlightReviewPageData(createDatabase(env.DB));
---
<BaseLayout title="Review observed flights" wide>
  <p class="mb-[.35rem] text-[.68rem] font-extrabold tracking-[.12em] text-gold-500 uppercase">Contributor workspace</p><h1>Observed-flight review</h1>
  <p class="mt-[.65rem] max-w-3xl text-[.92rem] text-muted-foreground">Review suggested trip matches before publication.</p>
  <BackfillForm client:load endpoint={appPath("/api/admin/tracks/backfill", env)} aircraft={aircraft.results} />
  <section class="mt-[1.8rem]"><h2>Suggested matches</h2><div class="overflow-x-auto rounded-lg border border-border bg-surface shadow-card"><Table><TableHeader><TableRow><TableHead>Trip</TableHead><TableHead>Observed path</TableHead><TableHead>Score</TableHead><TableHead>AI suggestion</TableHead><TableHead>Review</TableHead></TableRow></TableHeader><TableBody>
    {candidates.results.map((candidate) => <TableRow>
      <TableCell><a href={appPath(`/trips/${candidate.trip_id}`, env)}>{candidate.report_date} · {candidate.raw_route}</a></TableCell>
      <TableCell><a href={appPath(`/admin/observed-flights/${candidate.flight_id}`, env)}>{candidate.tail_no} · {new Date(candidate.started_at_utc).toLocaleString()}</a></TableCell>
      <TableCell>{candidate.score.toFixed(3)}</TableCell>
      <TableCell>{candidate.ai_rank ? `#${candidate.ai_rank} — ${candidate.ai_explanation}` : "Not ranked"}</TableCell>
      <TableCell><CandidateAction client:load endpoint={appPath(`/api/admin/matches/${candidate.id}`, env)} /></TableCell>
    </TableRow>)}
    {candidates.results.length === 0 && <TableRow><TableCell colSpan={5} className="px-6 py-12 text-center text-muted-foreground">No suggested matches need review.</TableCell></TableRow>}
  </TableBody></Table></div></section>
</BaseLayout>
