---
import type { Feature, LineString } from "geojson";
import { env } from "cloudflare:workers";
import { createDatabase } from "../../../db/client";
import FlightMap from "../../../components/FlightMap";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getAircraftProfile } from "../../../lib/aircraft-profile";
import { appPath } from "../../../lib/config";
import { getPublicObservedFlight } from "../../../lib/db/public-queries";
import { aircraftRoute, tripRoute } from "../../../lib/public-routes";
import { safeJson } from "../../../lib/utils";
import AircraftBadge from "../../../components/AircraftBadge";
import { Card } from "../../../components/ui/card";

export const prerender = false;

const observed = await getPublicObservedFlight(
  createDatabase(env.DB),
  Astro.params.id,
);
if (!observed) return Astro.redirect(appPath("/trips", env), 302);
const { flight, links } = observed;

const profile = getAircraftProfile(
  String(flight.tail_no),
  String(flight.manufacturer ?? ""),
);
const geometry = safeJson<Feature<LineString> | null>(
  String(flight.geometry_json),
  null,
);
const trackingDate = String(flight.started_at_utc).slice(0, 10);
const trackingLinks = [
  ...(flight.icao_no
    ? [{
        label: "ADS-B Exchange",
        href: `https://globe.adsbexchange.com/?icao=${String(flight.icao_no).toLocaleLowerCase("en-US")}&showTrace=${trackingDate}`,
      }]
    : []),
  {
    label: "Flightradar24",
    href: `https://www.flightradar24.com/data/aircraft/${String(flight.tail_no).toLocaleLowerCase("en-US")}`,
  },
];
const statusLabel =
  flight.state === "suggested"
    ? "Possible report match"
    : flight.state === "linked"
      ? "Linked to a public record"
      : "Observed only";
const startedAt = new Date(String(flight.started_at_utc));
const endedAt = new Date(String(flight.ended_at_utc));
const utcDateTime = (date: Date) =>
  date.toLocaleString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
    hour: "numeric",
    minute: "2-digit",
    timeZone: "UTC",
  });
---

<BaseLayout title={`${flight.tail_no} observed trip`}>
  <article class="w-full">
    <header class="mb-4 flex items-center justify-between gap-6 max-[560px]:flex-col max-[560px]:items-start max-[560px]:gap-[.6rem]">
      <h1 class="m-0 flex items-center gap-[.65rem] text-[clamp(1.45rem,2.6vw,2rem)] font-[780] tracking-[-.025em] max-[560px]:flex-wrap max-[560px]:items-start [&>span:last-child]:font-[720]">
        <AircraftBadge
          tailNo={String(flight.tail_no)}
          type={profile.type}
          href={appPath(aircraftRoute(String(flight.tail_no)), env)}
        />
        <span>on {startedAt.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" })}</span>
      </h1>
    </header>

    {geometry ? (
      <div>
        <FlightMap
          client:visible
          features={[geometry]}
          title={`${flight.tail_no} recorded movement`}
          vehicle={profile.type === "Helicopter" ? "helicopter" : "airplane"}
          externalLinks={trackingLinks}
          showToolbar={false}
          className="rounded-[.45rem] [&_[data-map-canvas]]:min-h-[clamp(18rem,34vw,25rem)]"
        />
      </div>
    ) : (
      <div class="rounded-[.45rem] border border-dashed border-border bg-[color-mix(in_srgb,var(--surface)_70%,transparent)] p-5 text-center text-muted-foreground [&_strong]:text-[.85rem] [&_strong]:text-foreground">
        <strong>The recorded path is unavailable.</strong>
      </div>
    )}

    <Card className="mt-[.85rem] min-w-0 gap-0! rounded-[.4rem]! border border-border bg-surface p-[.9rem]! shadow-none ring-0 max-[560px]:p-4! [&>h2]:mb-[.7rem] [&>h2]:text-xl [&>h2]:font-[780] [&>h2]:tracking-[-.015em]">
      <h2>Observed aircraft movement</h2>
      <div class="grid gap-[.8rem] max-[900px]:grid-cols-1">
        <dl class="m-0 grid grid-cols-2 overflow-hidden rounded-[.35rem] border border-border max-[560px]:grid-cols-1 [&>div]:min-w-0 [&>div]:border-r [&>div]:border-b [&>div]:border-border [&>div]:px-[.68rem] [&>div]:py-[.58rem] [&>div:nth-child(2)]:border-r-0 [&>div:last-child]:border-r-0 [&>div:nth-last-child(-n+2)]:border-b-0 max-[560px]:[&>div]:col-auto max-[560px]:[&>div]:border-r-0 max-[560px]:[&>div]:border-b max-[560px]:[&>div:last-child]:border-b-0 [&_dt]:text-[.65rem] [&_dt]:font-bold [&_dt]:text-muted-foreground [&_dd]:mt-[.2rem] [&_dd]:mb-0 [&_dd]:text-[.9rem] [&_dd]:font-[720] [&_dd_a]:text-[#2a76c6] [&_dd_a]:no-underline [&_dd_a:hover]:underline">
          <div><dt>Started</dt><dd>{utcDateTime(startedAt)} UTC</dd></div>
          <div><dt>Ended</dt><dd>{utcDateTime(endedAt)} UTC</dd></div>
          <div><dt>Duration</dt><dd>{(Number(flight.duration_seconds) / 3600).toFixed(1)} hr</dd></div>
          <div><dt>Record status</dt><dd>{statusLabel}</dd></div>
        </dl>
        <div class="grid gap-[.6rem] [&>div]:rounded-[.35rem] [&>div]:border [&>div]:border-border [&>div]:bg-[color-mix(in_srgb,var(--sky-100)_35%,var(--surface))] [&>div]:px-[.72rem] [&>div]:py-[.62rem] [&_h3]:mb-[.3rem] [&_h3]:text-[.68rem] [&_h3]:tracking-[.08em] [&_h3]:uppercase [&_p]:m-0 [&_p]:text-[.86rem] [&_p]:text-foreground">
          <div>
            <h3>Limited trip data</h3>
            <p>This aircraft movement was recorded by a flight-tracking source, but no published trip record currently supplies its route, passengers, agency, or purpose.</p>
          </div>
        </div>
      </div>

      <footer class="mt-4 flex flex-wrap items-center justify-start gap-x-[.8rem] gap-y-[.3rem] border-t border-border pt-[.8rem] text-[.65rem] text-muted-foreground [&_a]:font-bold [&_em]:not-italic">
        <span class="text-[.6rem] font-extrabold tracking-[.06em] text-muted-foreground uppercase">Source</span>
        <span>{String(flight.provider)} flight-path observation</span>
      </footer>
    </Card>

    {links.results.length > 0 && (
      <section class="mt-7">
        <h2>Related public records</h2>
        {links.results.map((trip) => (
          <a class="grid grid-cols-[7rem_minmax(0,1fr)_auto] items-center gap-4 border-b border-border py-[.85rem] no-underline max-[560px]:grid-cols-[1fr_auto] max-[560px]:gap-x-3 max-[560px]:gap-y-[.3rem]" href={appPath(tripRoute({ id: trip.id, tailNo: String(flight.tail_no), reportDate: trip.report_date }), env)}>
            <span class="text-[.72rem] text-muted-foreground max-[560px]:col-start-1">{trip.report_date}</span>
            <strong>{trip.raw_route}</strong>
            <b class="text-gold-500 max-[560px]:col-start-2 max-[560px]:row-[1/3]" aria-hidden="true">→</b>
          </a>
        ))}
      </section>
    )}
  </article>
</BaseLayout>
